{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "saas-maker",
  "target": "IssuePages repository publication on public product detail pages",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "apps/showcase/PRODUCT.md",
    "design": "apps/showcase/DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": "artifacts/design/project-detail-before-1440.png"
  },
  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": "artifacts/design/after-390.png"
      },
      {
        "width": 768,
        "path": "artifacts/design/after-768.png"
      },
      {
        "width": 1440,
        "path": "artifacts/design/after-1440.png"
      }
    ],
    "projectCheck": {
      "command": "pnpm test && pnpm build:showcase",
      "status": "pass"
    },
    "critique": {
      "score": 40,
      "maximum": 40
    },
    "audit": {
      "score": 20,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": [
        "The detector returned zero findings. Independent review resolved hierarchy, contrast, touch-target, layout-shift, and runtime-fallback findings; blocked-script fallback evidence is captured in artifacts/design/fallback-390.png."
      ]
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "Owner approved the feature and delegated implementation in the established preserve lane."
  }
}
