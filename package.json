{
  "name": "saas-maker",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:api": "pnpm -F @saas-maker/api dev",
    "dev:cockpit": "pnpm -F @saas-maker/dashboard dev",
    "dev:cockpit:local": "node scripts/dev-cockpit-local.mjs",
    "build": "turbo run build",
    "build:api": "pnpm -F @saas-maker/api typecheck",
    "build:cockpit": "turbo run build --filter=@saas-maker/dashboard...",
    "build:widget": "pnpm -F @saas-maker/feedback build",
    "check:shared-packages": "pnpm --filter @saas-maker/ai-chat-footer --filter @saas-maker/portfolio-project-strip run check",
    "build:showcase": "pnpm -F @saas-maker/landing-page build",
    "deploy:guard": "bash tooling/scripts/fleet-deploy-guard.sh saas-maker",
    "tooling:check": "cd tooling && node scripts/audit.mjs --validate-only && node --test test/*.test.mjs && node scripts/validate-tooling.mjs && node scripts/ai-client-audit.mjs --check && node scripts/clarity-audit.mjs --check",
    "tooling:ai-clients": "cd tooling && node scripts/ai-client-audit.mjs --omit-private --output reports/ai-clients/latest.json",
    "tooling:credentials": "node tooling/scripts/credential-guard.mjs",
    "tooling:clarity": "cd tooling && node scripts/clarity-audit.mjs --scan-fleet --omit-private",
    "tooling:footers": "node tooling/scripts/footer-source-audit.mjs --manifest ../site-health/apps/backend/config/footer-surfaces.json --fleet-root .. --check",
    "deploy:directory": "pnpm deploy:guard && pnpm -F @saas-maker/landing-page run deploy",
    "deploy:api": "pnpm deploy:guard && pnpm -F @saas-maker/api run deploy",
    "deploy:cockpit": "pnpm deploy:guard && pnpm -F @saas-maker/dashboard run deploy",
    "catalog:sync-public": "node scripts/sync-fleet-public-products.mjs",
    "catalog:check-public": "node scripts/sync-fleet-public-products.mjs --check",
    "catalog:validate-public": "node scripts/sync-fleet-public-products.mjs --validate",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "vitest run tests",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "smoke": "node scripts/smoke-prod.mjs",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "husky": "9.1.7",
    "turbo": "2.5.4",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
