---
import { GITHUB_ORG_URL, PACKAGE_URL } from '../data/links';
const OWNER_URL = 'https://sarthakagrawal.dev';
const isChangelog = Astro.url.pathname.startsWith('/changelog');
---
<footer class="footer">
  <div class="footer-brand">
    <span class="brand-mark sm" aria-hidden="true">S</span>
    <span>Built and maintained by <a href={OWNER_URL} target="_blank" rel="noopener noreferrer">Sarthak Agrawal</a></span>
  </div>
  <div class="footer-links">
    <a href="/changelog" aria-current={isChangelog ? 'page' : undefined}>Changelog</a>
    <a href="/learnings">Learnings</a>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href={PACKAGE_URL} target="_blank" rel="noopener noreferrer">Package</a>
    <a href={GITHUB_ORG_URL} target="_blank" rel="noopener noreferrer">Public source index</a>
  </div>
  <p class="footer-tagline">Curious products. Real domains. Work that keeps moving.</p>
</footer>
