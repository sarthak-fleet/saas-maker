---
import { CORE } from '../data/projects';
import { STUDIO_PROFILE } from '../data/studio';

const PANE_TONES = ['cobalt', 'seeded', 'amber', 'oxblood'];
---

<header class="studio-hero" aria-labelledby="studio-title">
  <div class="studio-hero-scene" aria-hidden="true"></div>

  <div class="studio-hero-copy glass-pane">
    <p class="studio-kicker">{STUDIO_PROFILE.eyebrow}</p>
    <h1 id="studio-title">{STUDIO_PROFILE.headline}</h1>
    <p class="studio-intro">{STUDIO_PROFILE.oneLine}</p>
    <a class="studio-thesis-link" href="/studio">
      Read the studio thesis <span aria-hidden="true">→</span>
    </a>
    <p class="studio-status">
      <span aria-hidden="true"></span>
      Built in public. Kept current.
    </p>
  </div>

  <ol class="featured-panes" aria-label="Products in focus">
    {CORE.map((project, index) => (
      <li class={`featured-pane featured-pane--${PANE_TONES[index]}`}>
        <a href={project.href}>
          <span class="featured-count">{String(index + 1).padStart(2, '0')}</span>
          <strong>{project.name}</strong>
          <span class="featured-description">{project.desc}</span>
          <span class="featured-foot">
            <span>{project.tag}</span>
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</header>
