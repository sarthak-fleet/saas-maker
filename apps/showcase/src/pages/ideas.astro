    width: fit-content;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    color: var(--copper-hi);
    font-weight: 600;
  }

  .idea-reasoning p + p {
    margin-top: 0.4rem;
  }

  .idea-context {
    width: 10rem;
  }

  .idea-context span,
  .idea-context small {
    display: block;
  }

  .idea-context span {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .idea-context small {
    margin-top: 0.25rem;
    color: var(--ink-muted);
  }

  .ideas-empty {
    padding: 4rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-top: 0;
    text-align: center;
  }

