  .ideas-controls select {
    width: 100%;
    padding: 0.65rem 0.75rem;
  }

  .ideas-controls input::placeholder {
    color: var(--ink-muted);
  }

  .ideas-best-toggle {
    grid-column: 1 / 3;
    flex-direction: row !important;
    align-items: center;
    gap: 0.75rem !important;
    cursor: pointer;
  }

  .ideas-best-toggle input {
    width: 1.25rem;
    min-height: 1.25rem;
    accent-color: var(--copper-hi);
  }

  .ideas-best-toggle span {
    color: var(--ink-soft) !important;
    font-size: 0.8rem !important;
  }

  .ideas-sort-mobile {
    display: none !important;
  }

  .ideas-result-line {
    grid-column: 3 / -1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 0.75rem 1rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .ideas-result-line button,
  .ideas-empty button {
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    color: var(--copper-hi);
    font-weight: 600;
  }

  .ideas-table-wrap {
    overflow-x: auto;
    border-inline: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .ideas-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .ideas-table th,
  .ideas-table td {
    padding: 0.85rem 1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .ideas-table th:last-child,
  .ideas-table td:last-child {
    border-right: 0;
  }

  .ideas-table th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg);
    text-align: left;
  }

  .ideas-table th button {
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--ink-muted);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ideas-table th[aria-sort] button {
    color: var(--copper-hi);
  }

  .ideas-table th[aria-sort='ascending'] button::after {
    content: ' ↑';
  }

  .ideas-table th[aria-sort='descending'] button::after {
    content: ' ↓';
  }

  .ideas-table tbody tr {
    background: var(--bg);
    transition: background 160ms ease;
  }

  .ideas-table tbody tr[hidden] {
    display: none !important;
  }

  .ideas-table tbody tr:hover {
    background: var(--surface);
  }

  .ideas-table td:first-child,
  .idea-score {
    width: 5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .idea-star {
    color: var(--workshop-oxblood);
    font-size: 1rem;
  }

  .idea-dash {
    color: var(--ink-muted);
  }

  .idea-score {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .idea-score--strong {
    background: var(--workshop-seeded);
    color: var(--workshop-ink);
  }

  .idea-copy {
    min-width: 30rem;
    max-width: 58rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .idea-copy :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .idea-copy :global(a) {
    color: var(--copper-hi);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .idea-copy :global(code) {
