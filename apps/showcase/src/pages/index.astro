---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TokenWorld from '../components/TokenWorld.astro';
import Fleet from '../components/Fleet.astro';
import Spec from '../components/Spec.astro';
import Commission from '../components/Commission.astro';
import Footer from '../components/Footer.astro';
import { STUDIO_PROFILE } from '../data/studio';

// Public product directory plus the one published SaaS Maker package.
---

<Layout
  title="SaaS Maker — Fleet products and shared tooling"
  description={STUDIO_PROFILE.oneLine}
>
  <!--
  THESIS: A maintained portfolio should feel like a workshop wall, not a startup card grid.
  OWN-WORLD: Limestone daylight, matte-black steel mullions, clear and seeded glass, with cobalt, amber, and oxblood panes.
  STORY: Understand the public directory and shared workshop, see four serious products immediately, then choose the complete directory, tooling, package, or studio context.
  FIRST VIEWPORT: One large clear hero bay shares a full-height wall with four saturated product panes.
  FORM: Monumental glass-wall elevation; selected probe A, delegated by the owner; direction seed 38815b6a.
  -->
  <div class="workshop-world">
    <Nav />
    <main id="main-content">
      <Hero />
      <Fleet />
      <Spec />
      <TokenWorld />
      <Commission />
    </main>
    <Footer />
  </div>
</Layout>
