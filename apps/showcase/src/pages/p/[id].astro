---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { DIRECTORY_PROJECTS, type DirectoryProject } from '../../data/directory';

export function getStaticPaths() {
  return DIRECTORY_PROJECTS.filter((product) => product.id !== 'saas-maker').map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

interface Props {
  product: DirectoryProject;
}

const { product } = Astro.props as Props;
const repositoryMatch = product.repositoryUrl?.match(
  /^https:\/\/github\.com\/([a-z\d](?:[a-z\d-]*[a-z\d])?)\/([a-z\d._-]+?)(?:\.git)?\/?$/i
);
const repositorySlug = repositoryMatch ? `${repositoryMatch[1]}/${repositoryMatch[2]}` : null;
const issuePagesOrigin = import.meta.env.DEV
  ? 'http://localhost:8787'
  : 'https://issues.sarthakagrawal.dev';
const profileUrl = `https://sassmaker.com/p/${product.id}`;
const publicLinks = [
  ...(product.changelogUrl
    ? [{ title: 'Changelog', url: product.changelogUrl, description: 'Product-owned release history' }]
    : []),
  ...(product.roadmapUrl
    ? [{ title: 'Issues', url: product.roadmapUrl, description: 'Open work in GitHub Issues' }]
    : []),
  ...(product.repositoryUrl
    ? [{ title: 'Source', url: product.repositoryUrl, description: 'Canonical public repository' }]
    : []),
];
const primaryUrl = product.url ?? product.repositoryUrl;
const primaryHost = primaryUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
const primaryLabel = product.url ? 'Open product' : product.repositoryUrl ? 'Open source' : 'Public status';
const groupLabel = {
  current: 'Current work',
  supporting: 'Supporting work',
  past: 'Past project',
}[product.group];
const deploymentLabel = product.deployed
  ? product.group === 'past'
    ? 'Live archive'
    : 'Deployed'
  : product.lifecycle === 'local-only' || product.platforms.includes('Local')
    ? 'Local only'
    : 'Not deployed';
const formatDate = (date: string | null) =>
  date
    ? new Intl.DateTimeFormat('en', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(`${date}T00:00:00Z`))
    : 'Not retained';
const hasPublicEvidence = publicLinks.length > 0;
const productSummary = product.purposeContract?.purpose ?? product.description;
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  url: profileUrl,
  description: productSummary,
  ...(primaryUrl || product.repositoryUrl
    ? {
        sameAs: [primaryUrl, product.repositoryUrl].filter(
          (value, index, values): value is string => Boolean(value) && values.indexOf(value) === index
        ),
      }
    : {}),
  applicationCategory: product.form,
};
---

<Layout title={`${product.name} — SaaS Maker directory`} description={productSummary}>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <!--
  THESIS: A project detail should reveal the maker's reason before it inventories the machinery, never collapse into an operations dossier.
  OWN-WORLD: Limestone daylight, black steel mullions, clear and seeded panes, with cobalt action, oxblood rationale, and amber evidence panes.
  STORY: Identify the project, understand why it exists, inspect its public anatomy and evidence, then return to the complete register.
  FIRST VIEWPORT: A slim directory rail sits above one large identity pane and one saturated canonical-product action.
  FORM: Product specimen elevation, owner-approved preserve-lane extension of the established monumental-wall direction.
  -->
  <div class="workshop-world">
    <Nav />

    <main class="project" id="main-content">
      <div class="project-wall">
        <div class="project-back">
          <a href="/projects">← Complete register</a>
          <span>{product.kind} · {groupLabel}</span>
        </div>

        <header class="project-hero">
          <div class="project-identity">
            <p class="project-folio">SaaS Maker directory</p>
            <h1>{product.name}</h1>
            <p class="project-summary">{productSummary}</p>
          </div>
          {primaryUrl ? (
            <a class="project-primary" href={primaryUrl} target="_blank" rel="noopener noreferrer">
              <span>{primaryLabel}</span>
              <strong>{primaryHost}</strong>
              <span class="project-primary-arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="project-primary project-primary--quiet">
              <span>Availability</span>
              <strong>{deploymentLabel === 'Local only' ? 'Maintained local tool' : 'Profile only'}</strong>
              <span>No public destination</span>
            </div>
          )}
        </header>

        <section class="project-why" aria-labelledby="why-title">
          <div class="project-why-title">
            <p class="project-folio">Maker note</p>
            <h2 id="why-title">Why I made this.</h2>
          </div>
          <blockquote>{product.makerNote}</blockquote>
        </section>

        {product.purposeContract && (
          <section class="project-contract" aria-labelledby="contract-title">
            <header>
              <p class="project-folio">Product contract</p>
              <h2 id="contract-title">What this product promises.</h2>
              <p>{product.purposeContract.purpose}</p>
            </header>
            <dl>
              <div><dt>For</dt><dd>{product.purposeContract.audience}</dd></div>
              <div><dt>Outcome</dt><dd>{product.purposeContract.outcome}</dd></div>
              <div><dt>How</dt><dd>{product.purposeContract.mechanism}</dd></div>
              <div><dt>Proof</dt><dd>{product.purposeContract.proof}</dd></div>
              <div class="project-contract-action"><dt>Next action</dt><dd>{product.purposeContract.nextAction}</dd></div>
            </dl>
          </section>
        )}

        <section class="project-anatomy" aria-labelledby="anatomy-title">
          <header>
            <p class="project-folio">Public anatomy</p>
            <h2 id="anatomy-title">What it is made of.</h2>
          </header>
          <dl>
            <div><dt>Form</dt><dd>{product.form}</dd></div>
            <div><dt>Platforms</dt><dd>{product.platforms.join(' · ')}</dd></div>
            <div><dt>Prominent tools</dt><dd>{product.technologies.join(' · ')}</dd></div>
            <div>
              <dt>Deployment</dt>
              <dd>{deploymentLabel}</dd>
              {product.deploymentProviders.length > 0 && <small>{product.deploymentProviders.join(' · ')}</small>}
            </div>
            <div><dt>First retained commit</dt><dd>{formatDate(product.firstCommitAt)}</dd></div>
            <div><dt>Latest retained commit</dt><dd>{formatDate(product.latestCommitAt)}</dd></div>
          </dl>
        </section>

        <section class="project-progress" aria-labelledby="progress-title">
          <div class="project-section-head">
            <p class="project-folio">{hasPublicEvidence ? 'Maintained evidence' : 'Public boundary'}</p>
            <h2 id="progress-title">{hasPublicEvidence ? 'Follow the work.' : 'Private by design.'}</h2>
            <p>
              {hasPublicEvidence
                ? 'Public destinations and repository evidence, when this project publishes them.'
                : 'The project can be understood here without exposing private or local source.'}
            </p>
          </div>

          <div class="project-evidence">
            {publicLinks.length > 0 ? (
              <ul>
                {publicLinks.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer">
                      <span>{link.title}</span>
                      <p>{link.description}</p>
                      <strong>Open ↗</strong>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="project-empty">
                This project does not publish repository evidence. Its reviewed rationale and
                public anatomy remain available on this profile.
              </p>
            )}
          </div>
        </section>

        {repositorySlug && (
          <section class="project-issues" aria-labelledby="issues-title">
            <div class="project-issues-title">
              <p class="project-folio">Repository publication</p>
              <h2 id="issues-title">Read the issues.</h2>
              <p>
                Public issues become a browsable, read-only record here. Open the source issue on
                GitHub to comment, react, or follow the work.
              </p>
            </div>
            <div class="project-issues-embed">
              <script
                is:inline
                data-astro-rerun
                async
                src={`${issuePagesOrigin}/embed.js?v=20260826-2`}
                data-repo={repositorySlug}
                data-theme="light"
                data-density="comfortable"
                data-variant="minimal"
                data-accent="#c9820d"
              ></script>
              <p class="project-issues-fallback">
                The embedded reader is loading or unavailable.
                <a href={`${product.repositoryUrl}/issues`}>Read the issues on GitHub.</a>
              </p>
            </div>
          </section>
        )}

        <section class="project-boundary">
          <p>
            Every fact here comes from the project’s reviewed public record. Private work and
            operational controls stay private.
          </p>
        </section>
      </div>

      <Footer />
    </main>
  </div>
</Layout>

<style>
  .project {
    width: var(--workshop-frame-width);
    margin: 0 auto;
    padding-bottom: 2rem;
  }

  .project-wall {
    overflow: hidden;
    border: 0.375rem solid var(--workshop-steel);
    border-top: 0;
    background: var(--workshop-steel);
  }

  .project-back {
    min-height: 3.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 0.375rem solid var(--workshop-steel);
    background: var(--workshop-seeded);
    color: #494842;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .project-back a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--workshop-oxblood);
  }

  .project-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.65fr);
    gap: 0.375rem;
    min-height: min(40rem, calc(100svh - 8.5rem));
    border-bottom: 0.375rem solid var(--workshop-steel);
    background: var(--workshop-steel);
  }

  .project-identity {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 7rem);
    background:
      linear-gradient(rgba(250, 247, 239, 0.92), rgba(250, 247, 239, 0.92)),
      url('/images/glazier-atelier-hero.webp') center / cover no-repeat;
    color: var(--workshop-ink);
  }

  .project-folio {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 10ch;
    margin-top: clamp(2rem, 5vh, 4rem);
    overflow-wrap: anywhere;
    font-size: clamp(3.5rem, 7.2vw, 6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-summary {
    max-width: 58ch;
    margin-top: clamp(1.75rem, 4vh, 3rem);
    color: var(--workshop-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .project-primary {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 4vw, 4rem);
    background: var(--workshop-cobalt);
    color: #fff;
    transition:
      filter 180ms ease,
      box-shadow 180ms ease;
  }

  .project-primary span {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-primary strong {
    max-width: 18ch;
    margin-top: auto;
    overflow-wrap: anywhere;
    font-size: clamp(1.5rem, 3vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .project-primary-arrow {
    align-self: flex-end;
    margin-top: 2rem;
    font-size: 1.5rem !important;
  }

  .project-primary:hover,
  .project-primary:focus-visible {
    filter: brightness(1.1) saturate(1.04);
    box-shadow: inset 0 0 0 0.25rem rgba(255, 255, 255, 0.48);
  }

  .project-primary--quiet {
    background: var(--workshop-seeded);
    color: var(--workshop-ink);
  }

  .project-why,
  .project-contract,
  .project-anatomy {
    display: grid;
    grid-template-columns: minmax(18rem, 0.55fr) minmax(0, 1.45fr);
    gap: 0.375rem;
    border-bottom: 0.375rem solid var(--workshop-steel);
    background: var(--workshop-steel);
  }

  .project-why-title,
  .project-contract > header,
  .project-anatomy > header {
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .project-why-title {
    background: var(--workshop-oxblood);
    color: #fff;
  }

  .project-why h2,
  .project-contract h2,
  .project-anatomy h2 {
    max-width: 9ch;
    margin-top: 1.25rem;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-why blockquote {
    min-height: 25rem;
    display: flex;
    align-items: center;
    margin: 0;
    padding: clamp(2.5rem, 7vw, 7rem);
    background: #f8f4ea;
    color: var(--workshop-ink);
    font-size: clamp(1.8rem, 3.3vw, 3.6rem);
    font-weight: 540;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: pretty;
  }

  .project-anatomy > header {
    background: var(--workshop-seeded);
    color: var(--workshop-ink);
  }

  .project-contract > header {
    background: var(--workshop-cobalt);
    color: #fff;
  }

  .project-contract > header > p:last-child {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .project-contract dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(20, 21, 17, 0.2);
  }

  .project-contract dl > div {
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #f8f4ea;
  }

  .project-contract .project-contract-action {
    grid-column: 1 / -1;
    min-height: 8rem;
    background: var(--workshop-amber);
  }

  .project-contract dt {
    color: var(--workshop-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-contract dd {
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    font-weight: 650;
    line-height: 1.25;
  }

  .project-anatomy dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(20, 21, 17, 0.2);
  }

  .project-anatomy dl > div {
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #f8f4ea;
  }

  .project-anatomy dt {
    color: var(--workshop-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-anatomy dd {
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    font-weight: 650;
    line-height: 1.25;
  }

  .project-anatomy small {
    color: var(--workshop-muted);
  }

  .project-progress {
    display: grid;
    grid-template-columns: minmax(20rem, 0.65fr) minmax(0, 1.35fr);
    gap: 0.375rem;
    background: var(--workshop-steel);
  }

  .project-section-head {
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(2rem, 5vw, 4.5rem);
    background: var(--workshop-amber);
    color: var(--workshop-ink);
  }

  .project-section-head h2 {
    max-width: 9ch;
    margin-top: 1.25rem;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-section-head > p:last-child {
    max-width: 36ch;
    margin-top: 1.5rem;
    color: var(--workshop-ink);
  }

  .project-evidence {
    min-width: 0;
    background: #f8f4ea;
  }

  .project-progress ul {
    list-style: none;
  }

  .project-progress li + li {
    border-top: 1px solid rgba(20, 21, 17, 0.2);
  }

  .project-progress li a {
    min-height: 8.25rem;
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 2rem;
    color: var(--workshop-ink);
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .project-progress li a > span {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .project-progress li p {
    color: var(--workshop-muted);
  }

  .project-progress li strong {
    font-size: 0.75rem;
  }

  .project-progress li a:hover,
  .project-progress li a:focus-visible {
    background: var(--workshop-oxblood);
    color: #fff;
  }

  .project-progress li a:hover p,
  .project-progress li a:focus-visible p {
    color: #f1d9d4;
  }

  .project-empty {
    min-height: 25rem;
    display: grid;
    place-items: center;
    padding: 3rem;
    color: var(--workshop-muted);
  }

  .project-boundary {
    min-height: 11rem;
    display: flex;
    align-items: center;
    padding: clamp(2rem, 4vw, 3.5rem);
    border-top: 0.375rem solid var(--workshop-steel);
    background:
      linear-gradient(rgba(217, 210, 196, 0.88), rgba(217, 210, 196, 0.88)),
      url('/images/glazier-atelier-hero.webp') 70% 55% / cover no-repeat;
    color: var(--workshop-muted);
    font-size: 1rem;
  }

  .project-issues {
    display: grid;
    grid-template-columns: minmax(20rem, 0.65fr) minmax(0, 1.35fr);
    gap: 0.375rem;
    border-top: 0.375rem solid var(--workshop-steel);
    background: var(--workshop-steel);
  }

  .project-issues-title {
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(2rem, 5vw, 4.5rem);
    background: var(--workshop-amber);
    color: var(--workshop-steel);
  }

  .project-issues-title h2 {
    max-width: 8ch;
    margin-top: 1.25rem;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-issues-title > p:last-child {
    max-width: 36ch;
    margin-top: 1.5rem;
    color: var(--workshop-steel);
  }

  .project-issues-embed {
    min-width: 0;
    min-height: 30rem;
    align-self: stretch;
    background: var(--workshop-seeded);
  }

  .project-issues-fallback {
    min-height: 30rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    color: var(--workshop-muted);
    text-align: center;
  }

  .project-issues-embed:has([data-issue-pages-embed]) > .project-issues-fallback {
    display: none;
  }

  .project-boundary p {
    max-width: 68ch;
  }

  @media (max-width: 900px) {
    .project-hero,
    .project-why,
    .project-contract,
    .project-anatomy,
    .project-progress,
    .project-issues {
      grid-template-columns: 1fr;
    }

    .project-primary {
      min-height: 18rem;
    }
  }

  @media (max-width: 760px) {
    .project-back {
      align-items: flex-start;
      flex-direction: column;
      gap: 0;
    }

    .project-identity {
      min-height: min(30rem, calc(100svh - 8rem));
      padding: 2.5rem 1.5rem;
    }

    h1 {
      max-width: none;
      margin-top: 2rem;
      font-size: clamp(2.8rem, 13vw, 5rem);
    }

    .project-primary {
      min-height: 15rem;
      padding: 2rem 1.5rem;
    }

    .project-section-head {
      min-height: 17rem;
      padding: 2.5rem 1.5rem;
    }

    .project-issues-title {
      min-height: 17rem;
      padding: 2.5rem 1.5rem;
    }

    .project-why-title,
    .project-contract > header,
    .project-anatomy > header {
      min-height: 14rem;
      padding: 2.5rem 1.5rem;
    }

    .project-why blockquote {
      min-height: 16rem;
      padding: 3rem 1.5rem;
    }

    .project-contract dl,
    .project-anatomy dl {
      grid-template-columns: 1fr;
    }

    .project-contract dl > div,
    .project-anatomy dl > div {
      min-height: 7.5rem;
    }

    .project-contract .project-contract-action {
      grid-column: auto;
    }

    .project-progress li a {
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1rem;
      padding: 1.5rem;
    }

    .project-progress li p {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .project-boundary {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
