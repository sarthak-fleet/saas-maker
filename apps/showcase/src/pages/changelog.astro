---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { CHANGELOG } from '../data/changelog';
import { GITHUB_ORG_URL } from '../data/links';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Changelog | SaaS Maker"
  description="A product-owned history of meaningful changes shipped by SaaS Maker."
>
  <div class="workshop-world">
    <Nav />
    <main class="changelog" id="main-content">
      <header class="changelog-hero">
        <div>
          <p class="changelog-kicker">Maintained product history</p>
          <h1>Changes worth remembering.</h1>
        </div>
        <aside class="changelog-intro">
          <p>
            A concise record of meaningful changes to SaaS Maker. This page
            records what actually shipped.
          </p>
          <nav aria-label="Project resources">
            <a href={GITHUB_ORG_URL} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </nav>
        </aside>
      </header>

      <ol class="changelog-list">
        {CHANGELOG.map((entry, index) => (
          <li>
            <article>
              <div class="changelog-date">
                <time datetime={entry.date}>{entry.label}</time>
                <span>{String(CHANGELOG.length - index).padStart(2, '0')}</span>
              </div>
              <div class="changelog-entry">
                <h2>{entry.title}</h2>
                <p>{entry.summary}</p>
                <ul>
                  {entry.changes.map((change) => <li>{change}</li>)}
                </ul>
              </div>
            </article>
          </li>
        ))}
      </ol>

      <div class="changelog-close">
        <p>Looking for a particular product?</p>
        <a href="/#products">Browse all products <span aria-hidden="true">↗</span></a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .changelog {
    width: min(92rem, calc(100% - 2rem));
    margin-inline: auto;
    border: 0.375rem solid var(--workshop-steel);
    border-top: 0;
  }

  .changelog-hero {
    min-height: 34rem;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(20rem, 0.65fr);
    background:
      linear-gradient(rgba(250, 247, 239, 0.88), rgba(250, 247, 239, 0.88)),
      url('/images/glazier-atelier-hero.webp') center / cover;
  }

  .changelog-hero > div,
  .changelog-hero > aside {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 6rem);
  }

  .changelog-hero > div {
    border-right: 0.375rem solid var(--workshop-steel);
  }

  .changelog-hero > aside {
    margin: 0;
    background: var(--workshop-cobalt);
    color: #fff;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.6;
  }

  .changelog-intro p {
    margin: 0;
  }

  .changelog-intro nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  .changelog-intro a {
    min-height: 2.75rem;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.65);
    font-weight: 700;
  }

  .changelog-kicker {
    margin: 0 0 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.5rem, 7.5vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .changelog-list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: rgba(250, 247, 239, 0.94);
  }

  .changelog-list > li {
    border-top: 0.375rem solid var(--workshop-steel);
  }

  article {
    display: grid;
    grid-template-columns: minmax(15rem, 0.38fr) minmax(0, 1fr);
  }

  .changelog-date,
  .changelog-entry {
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .changelog-date {
    min-height: 22rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 0.375rem solid var(--workshop-steel);
    background: var(--workshop-seeded);
    color: var(--workshop-ink);
    font-size: 0.82rem;
  }

  .changelog-date span {
    color: var(--workshop-steel);
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }

  .changelog-entry h2 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }

  .changelog-entry > p {
    max-width: 60ch;
    margin: 1.5rem 0 0;
    color: var(--workshop-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
  }

  .changelog-entry ul {
    max-width: 64rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(20, 21, 17, 0.2);
  }

  .changelog-entry li {
    position: relative;
    padding: 1rem 0 1rem 1.5rem;
    border-bottom: 1px solid rgba(20, 21, 17, 0.2);
    line-height: 1.5;
  }

  .changelog-entry li::before {
    position: absolute;
    top: 1.45rem;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--workshop-amber);
    content: '';
  }

  .changelog-close {
    min-height: 15rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-top: 0.375rem solid var(--workshop-steel);
    background: var(--workshop-amber);
  }

  .changelog-close p {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .changelog-close a {
    min-height: 3rem;
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .changelog-hero {
      grid-template-columns: 1fr;
    }

    .changelog-hero {
      min-height: 0;
    }

    .changelog-hero > div {
      min-height: 27rem;
      border-right: 0;
    }

    .changelog-hero > aside {
      min-height: 16rem;
      border-top: 0.375rem solid var(--workshop-steel);
    }

    h1 {
      font-size: clamp(2.75rem, 11.5vw, 4.25rem);
    }
  }

  @media (max-width: 760px) {
    article,
    .changelog-close {
      grid-template-columns: 1fr;
    }

    .changelog-date {
      min-height: 10rem;
      flex-direction: row;
      align-items: flex-end;
      border-right: 0;
      border-bottom: 0.375rem solid var(--workshop-steel);
    }

    .changelog-close {
      align-items: start;
    }
  }
</style>
