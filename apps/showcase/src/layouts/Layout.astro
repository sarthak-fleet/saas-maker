---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const SITE_URL = 'https://sassmaker.com';
const DEFAULT_TITLE = 'SaaS Maker — product studio and public software directory';
const DEFAULT_DESCRIPTION =
  'Product studio and directory for focused software: CodeVetter, PostTrainLLM, Pace, High Signal, and more — built and maintained in public by Sarthak Agrawal.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  type = 'website',
  publishedTime,
} = Astro.props;

// Cloudflare Pages serves clean URLs without `.html`; canonicals should match.
const pathname =
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;

// Social preview image served from the static public asset set.
const OG_IMAGE = `${SITE_URL}/og-image.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SaaS Maker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta
      name="keywords"
      content="saas maker, product studio, software product directory, codevetter, posttrainllm, heypace, high signal, sarthak agrawal"
    />
    <meta name="author" content="Sarthak Agrawal" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    {/* One type family keeps the directory calm and reduces font payload. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      />
    </noscript>

    {/* Generated JSON-LD: edit its canonical registry rather than this block. */}

  <!-- fleet-jsonld:start (generated by apply-agent-surfaces; edit registry, not this) -->
<script is:inline type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://sarthakagrawal.dev/#person","name":"Sarthak Agrawal","jobTitle":"AI Infrastructure & Product Engineer","url":"https://sarthakagrawal.dev","image":"https://avatars.githubusercontent.com/u/43884471?v=4","sameAs":["https://sarthakagrawal.dev","https://www.linkedin.com/in/sarthakagrawal927","https://github.com/sarthakagrawal927","https://x.com/sarthakcodes","https://huggingface.co/sarthakagrawal927"],"knowsAbout":["AI infrastructure","Local-first software","Post-training language models","AI code review","Cloudflare Workers","TypeScript","Rust"],"affiliation":{"@type":"Organization","@id":"https://sassmaker.com/#app","name":"SaaS Maker","url":"https://sassmaker.com"}},{"@type":"WebSite","@id":"https://sassmaker.com/#app","name":"SaaS Maker","alternateName":["SassMaker","sassmaker.com"],"url":"https://sassmaker.com","description":"Software as a specialized service: a living studio of focused products built for particular problems.","publisher":{"@id":"https://sarthakagrawal.dev/#person"},"sameAs":["https://github.com/sass-maker"]}]}</script>
<!-- fleet-jsonld:end -->
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="saas-maker"
      defer
    ></script>
  </body>
</html>
