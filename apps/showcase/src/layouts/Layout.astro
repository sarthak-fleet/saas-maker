---
import '../styles/globals.css';
import { STUDIO_JSON_LD, STUDIO_PROFILE } from '../data/studio';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const SITE_URL = 'https://sassmaker.com';
const DEFAULT_TITLE = 'SaaS Maker — product studio and public software directory';
const DEFAULT_DESCRIPTION = STUDIO_PROFILE.oneLine;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  type = 'website',
  publishedTime,
} = Astro.props;

// Cloudflare Pages serves clean URLs without `.html`; canonicals should match.
const pathname =
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;

// Social preview image served from the static public asset set.
const OG_IMAGE = `${SITE_URL}/og-image.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SaaS Maker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta
      name="keywords"
      content="saas maker, product studio, software product directory, codevetter, posttrainllm, heypace, high signal, sarthak agrawal"
    />
    <meta name="author" content="Sarthak Agrawal" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    {/* One type family keeps the directory calm and reduces font payload. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      />
    </noscript>

    {/* Canonical Person → Studio → WebSite graph from the public studio profile. */}
    <script type="application/ld+json" set:html={JSON.stringify(STUDIO_JSON_LD)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="saas-maker"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="SaaS Maker"
      defer
    ></script>
  </body>
</html>
