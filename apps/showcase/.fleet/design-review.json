{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "showcase",
  "target": "Ideas, Tools, and Learnings theme unification",
  "mode": "preserve",
  "register": "brand",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
