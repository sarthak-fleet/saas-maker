{
  "name": "@saas-maker/portfolio-project-strip",
  "version": "0.1.0",
  "description": "A fast, accessible animated footer strip for linking an author's current projects.",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/@saas-maker/portfolio-project-strip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sass-maker/saas-maker.git",
    "directory": "packages/portfolio-project-strip"
  },
  "bugs": "https://github.com/sass-maker/saas-maker/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/element.d.mts",
      "import": "./dist/browser/element.mjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom && tsup src/element.ts --format esm --dts --out-dir dist/browser",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm catalog:generate && pnpm typecheck && pnpm typecheck:contracts && pnpm lint && pnpm build && pnpm test && pnpm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
